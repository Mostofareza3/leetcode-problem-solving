{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build and Run C++",
        "type": "shell",
        "command": "/opt/homebrew/bin/g++-15",
        "args": [
          "-std=c++17",
          "${file}",
          "-o",
          "${fileDirname}/${fileBasenameNoExtension}"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": ["$gcc"],
        "detail": "Compile current C++ file with g++-15"
      },
      {
        "label": "Run Executable",
        "type": "shell",
        "command": "${fileDirname}/${fileBasenameNoExtension}",
        "group": {
          "kind": "test",
          "isDefault": true
        },
        "dependsOn": "Build and Run C++",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": true,
          "panel": "shared"
        }
      }
    ]
  }